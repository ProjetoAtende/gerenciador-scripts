# Copie para .env (não versionado). Secrets de build vão também no GitHub Actions.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Apenas scripts Node locais (NÃO prefixo VITE_ — nunca importar no src/)
SUPABASE_SERVICE_ROLE_KEY=

VITE_DEEPSEEK_API_KEY=
VITE_OPENAI_API_KEY=

# Opcional: URL pública do GitHub Pages (e-mails e links)
# VITE_APP_PUBLIC_ORIGIN=https://projetoatende.github.io/gerenciador-scripts

# Referência do repositório remoto (deploy manual)
# GITHUB=https://github.com/ProjetoAtende/gerenciador-scripts

# Smoke / seeds Atende Stack (opcional, só local — ver docs/ATENDE_STACK_OPERACAO.md)
# SMOKE_TEST_EMAIL=
# SMOKE_TEST_PASSWORD=
# SMOKE_TEST_USER_EMAIL=
# SMOKE_TEST_USER_PASSWORD=
