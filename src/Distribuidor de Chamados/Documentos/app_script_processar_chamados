/**
 * Decodifica entidades HTML básicas
 */
function decodificarHTML(texto) {
  if (!texto) return texto;
  
  return texto
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&apos;/g, "'")
    .replace(/&nbsp;/g, ' ')
    .replace(/=C3=A1/g, 'á')
    .replace(/=C3=A9/g, 'é')
    .replace(/=C3=AD/g, 'í')
    .replace(/=C3=B3/g, 'ó')
    .replace(/=C3=BA/g, 'ú')
    .replace(/=C3=A0/g, 'à')
    .replace(/=C3=A2/g, 'â')
    .replace(/=C3=AA/g, 'ê')
    .replace(/=C3=B4/g, 'ô')
    .replace(/=C3=A7/g, 'ç')
    .replace(/=C3=A3/g, 'ã')
    .replace(/=C3=B5/g, 'õ');
}

/**
 * Converte data do formato brasileiro para ISO
 */
function converterDataParaISO(dataString) {
  try {
    // Formato esperado: 24/07/2025 17:17
    const match = dataString.match(/(\d{2})\/(\d{2})\/(\d{4})\s+(\d{2}):(\d{2})/);
    
    if (match) {
      const [, dia, mes, ano, hora, minuto] = match;
      const dataISO = `${ano}-${mes}-${dia}T${hora}:${minuto}:00-03:00`;
      return dataISO;
    }
    
    // Se não conseguir parsear, tenta conversão direta
    const data = new Date(dataString);
    return data.toISOString();
    
  } catch (error) {
    console.error('Erro ao converter data:', error);
    return new Date().toISOString(); // Fallback para data atual
  }
}

/**
 * Verifica se o chamado já existe no Supabase
 * Retorna: null (não existe) | objeto com dados do chamado existente
 */
function verificarChamadoExiste(numeroChamado) {
  try {
    const url = `${SUPABASE_URL}/rest/v1/tickets?numero_chamado=eq.${numeroChamado}&select=id,usuario_atual,status`;
    
    const response = UrlFetchApp.fetch(url, {
      method: 'GET',
      headers: {
        'apikey': SUPABASE_ANON_KEY,
        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
        'Content-Type': 'application/json'
      }
    });
    
    const data = JSON.parse(response.getContentText());
    return data.length > 0 ? data[0] : null;
    
  } catch (error) {
    console.error('Erro ao verificar chamado existente:', error);
    return null;
  }
}

/**
 * Insere ticket no Supabase
 */
function inserirTicketSupabase(dadosChamado) {
  try {
    const url = `${SUPABASE_URL}/rest/v1/tickets`;
    
    const payload = {
      numero_chamado: dadosChamado.numero_chamado,
      gse: dadosChamado.gse,
      tempo_espera_origem: dadosChamado.tempo_espera_origem,
      descricao: dadosChamado.descricao,
      email: dadosChamado.email,
      vip: dadosChamado.vip,
      is_reopened: dadosChamado.is_reopened || false,
      status: 'aguardando'
    };
    
    const response = UrlFetchApp.fetch(url, {
      method: 'POST',
      headers: {
        'apikey': SUPABASE_ANON_KEY,
        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
        'Content-Type': 'application/json',
        'Prefer': 'return=minimal'
      },
      payload: JSON.stringify(payload)
    });
    
    return response.getResponseCode() === 201;
    
  } catch (error) {
    console.error('Erro ao inserir no Supabase:', error);
    return false;
  }
}


