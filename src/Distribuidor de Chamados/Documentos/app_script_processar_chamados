    }
    
  } catch (error) {
    console.error('Erro ao processar email:', error);
  }
}

/**
 * Extrai um campo do HTML usando múltiplos padrões
 * @param {string} htmlLimpo - HTML já processado e limpo
 * @param {string} nomeCampo - Nome do campo a ser extraído (ex: "Data de Abertura", "Email")
 * @param {boolean} textoLongo - Se true, captura texto mais longo (para descrições)
 * @returns {string|null} - Valor extraído ou null
 */
function extrairCampoHTML(htmlLimpo, nomeCampo, textoLongo = false) {
  try {
    // Prepara o nome do campo para regex (escapa caracteres especiais)
    const campoEscapado = nomeCampo.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

    // Define o padrão de captura baseado no tipo de conteúdo
    const padraoCaptura = textoLongo ? '([\\s\\S]{1,2000}?)' : '([^<>]{1,500}?)';

    // Lista de padrões a serem testados (do mais específico ao mais genérico)
    const padroes = [
      // Padrão 1: Estrutura com <span> (formato antigo)
      new RegExp(campoEscapado + ':.*?<\\/span>.*?<span[^>]*>' + padraoCaptura + '<\\/span>', 'i'),

      // Padrão 2: Estrutura de tabela com <td>
      new RegExp(campoEscapado + ':\\s*<\\/td>\\s*<td[^>]*>' + padraoCaptura + '<\\/td>', 'i'),

      // Padrão 3: Campo seguido diretamente por valor (qualquer tag)
      new RegExp(campoEscapado + ':[^<]*<[^>]+>' + padraoCaptura + '<\\/', 'i'),

      // Padrão 4: Campo seguido de valor com espaços (dentro de tags)
      new RegExp(campoEscapado + ':\\s*<[^>]*>\\s*' + padraoCaptura + '\\s*<', 'i'),

      // Padrão 5: Campo seguido de valor sem tags específicas (mais genérico)
      new RegExp(campoEscapado + ':\\s*' + padraoCaptura + '(?:<|\\s{2,}|Atenciosamente)', 'i'),

      // Padrão 6: Para descrições longas - captura até encontrar palavras-chave de fim
      textoLongo ? new RegExp(campoEscapado + ':\\s*' + padraoCaptura + '(?:Atenciosamente|Enviado automaticamente|Suporte)', 'i') : null
    ].filter(p => p !== null);

    // Tenta cada padrão até encontrar um match
    for (const padrao of padroes) {
      const match = htmlLimpo.match(padrao);
      if (match && match[1]) {
        let valor = match[1].trim();

        // Remove tags HTML que possam ter sobrado
        valor = valor.replace(/<[^>]*>/g, '').trim();

        // Decodifica entidades HTML
        valor = decodificarHTML(valor);

        // Remove espaços múltiplos
        valor = valor.replace(/\s+/g, ' ').trim();

        // Verifica se o valor extraído não é vazio ou muito curto
        if (valor && valor.length > 0) {
          console.log(`Campo "${nomeCampo}" extraído com sucesso: ${valor.substring(0, 50)}${valor.length > 50 ? '...' : ''}`);
          return valor;
        }
      }
    }

    // Se chegou aqui, nenhum padrão funcionou
    console.log(`Aviso: Campo "${nomeCampo}" não encontrado no HTML`);
    return null;

  } catch (error) {
    console.error(`Erro ao extrair campo "${nomeCampo}":`, error);
    return null;
  }
}

