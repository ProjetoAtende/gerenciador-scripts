/**
 * Função principal que processa emails de chamados
 * Executada automaticamente pelo trigger a cada 15 minutos
 */
function processarChamados() {
  try {
    
    console.log('Iniciando processamento de chamados...');
    
    // Busca emails não lidos com label 'Chamados-Sistema'
    const label = GmailApp.getUserLabelByName('Chamados-Sistema');
    if (!label) {
      console.log('Label "Chamados-Sistema" não encontrada. Crie o filtro primeiro.');
      return;
    }
    
    const threads = label.getThreads();
    const emailsNaoLidos = threads.filter(thread => thread.isUnread());
    
    console.log(`Encontrados ${emailsNaoLidos.length} emails não lidos`);
    
    for (const thread of emailsNaoLidos) {
      const messages = thread.getMessages();
      
      for (const message of messages) {
        if (message.isUnread()) {
          processarEmail(message);
          message.markRead(); // Marca como lido após processar
        }
      }
    }
    
    console.log('Processamento concluído');
    
  } catch (error) {
    console.error('Erro no processamento:', error);
    enviarEmailErro(error);
  }
}

/**
 * Processa um email individual
 */
function processarEmail(message) {
  try {
    const assunto = message.getSubject();
    const corpoHtml = message.getBody(); // Pega o HTML do email
    const remetente = message.getFrom();
    
    console.log(`Processando email: ${assunto}`);
    
    // Verifica se é um email de chamado válido
    if (!assunto.includes('[CHAMADO]')) {
      console.log('Email não é um chamado válido');
      return;
    }
    
    // Extrai dados do email
    const dadosChamado = extrairDadosHTML(assunto, corpoHtml);
    
    if (!dadosChamado) {
      console.log('Não foi possível extrair dados do email');
      return;
    }
    
    // Verifica se já existe no Supabase
    const chamadoExistente = verificarChamadoExiste(dadosChamado.numero_chamado);
    
    if (chamadoExistente) {
      console.log(`Chamado ${dadosChamado.numero_chamado} já existe no sistema - inserindo como reabertura`);
      
      // Marca como reabertura e insere na fila central
      const dadosReabertura = {
        ...dadosChamado,
        is_reopened: true
      };
      
      const sucesso = inserirTicketSupabase(dadosReabertura);
      
      if (sucesso) {
        console.log(`Chamado ${dadosChamado.numero_chamado} inserido como reabertura na fila central`);
      } else {
        console.log(`Erro ao inserir reabertura do chamado ${dadosChamado.numero_chamado}`);
      }
      return;
    }
    
    // Insere no Supabase
    const sucesso = inserirTicketSupabase(dadosChamado);
    
    if (sucesso) {
      console.log(`Chamado ${dadosChamado.numero_chamado} inserido com sucesso`);
