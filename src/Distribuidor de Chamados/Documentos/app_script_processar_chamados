function enviarEmailErro(error) {
  try {
    const assunto = 'Erro no Processador de Chamados';
    const corpo = `
Ocorreu um erro no processamento dos chamados:

Erro: ${error.message}
Stack: ${error.stack}
Data/Hora: ${new Date().toLocaleString('pt-BR')}
    `;
    
    GmailApp.sendEmail(SENDER_EMAIL, assunto, corpo);
    
  } catch (emailError) {
    console.error('Erro ao enviar email de erro:', emailError);
  }
}

