/**
 * Função para configurar o trigger (execute UMA VEZ)
 * Cria um trigger que executa a cada 15 minutos
 */
function configurarTrigger() {
  try {
    // Remove triggers antigos
    const triggersAntigos = ScriptApp.getProjectTriggers();
    triggersAntigos.forEach(trigger => {
      if (trigger.getHandlerFunction() === 'processarChamados') {
        ScriptApp.deleteTrigger(trigger);
      }
    });
    console.log(`Removidos ${triggersAntigos.length} triggers antigos`);
    
    // Cria trigger a cada 15 minutos
    ScriptApp.newTrigger('processarChamados')
      .timeBased()
      .everyMinutes(15)
      .create();
    
    console.log('✅ Trigger configurado com sucesso!');
    console.log('   - Executa a cada 15 minutos (24/7)');
    console.log('   - Processa emails não lidos com label "Chamados-Sistema"');
    
  } catch (error) {
    console.error('Erro ao configurar trigger:', error);
    enviarEmailErro(error);
  }
}

