-- 9. Habilitar Row Level Security (RLS)
ALTER TABLE users ENABLE ROW LEVEL SECURITY;
ALTER TABLE tickets ENABLE ROW LEVEL SECURITY;
ALTER TABLE gse_equipes ENABLE ROW LEVEL SECURITY;

-- 10. Políticas básicas de RLS (ajuste conforme suas necessidades)
-- Usuários podem ver apenas seus próprios dados
CREATE POLICY "Usuários podem ver próprios dados" ON users
  FOR SELECT USING (auth.uid() = id);

-- Todos usuários autenticados podem ver tickets
CREATE POLICY "Usuários autenticados podem ver tickets" ON tickets
  FOR SELECT USING (auth.role() = 'authenticated');

-- Usuários podem atualizar apenas tickets atribuídos a eles
CREATE POLICY "Usuários podem atualizar próprios tickets" ON tickets
  FOR UPDATE USING (usuario_atual = auth.uid());

-- Admins podem fazer tudo
CREATE POLICY "Admins podem tudo em users" ON users
  FOR ALL USING (
    EXISTS (
      SELECT 1 FROM users 
      WHERE id = auth.uid() AND role = 'admin'
    )
  );

CREATE POLICY "Admins podem tudo em tickets" ON tickets
  FOR ALL USING (
    EXISTS (
      SELECT 1 FROM users 
      WHERE id = auth.uid() AND role = 'admin'
    )
  );

-- Todos usuários autenticados podem ver mapeamentos GSE -> equipe
CREATE POLICY "Usuários autenticados podem ver gse_equipes" ON gse_equipes
  FOR SELECT USING (auth.role() = 'authenticated');

-- Admins podem gerenciar mapeamentos GSE -> equipe
CREATE POLICY "Admins podem tudo em gse_equipes" ON gse_equipes
  FOR ALL USING (
    EXISTS (
      SELECT 1 FROM users 
      WHERE id = auth.uid() AND role = 'admin'
    )
  );