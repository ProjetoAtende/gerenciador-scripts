-- Script SQL para executar no SQL Editor do Supabase

-- 1. Criar tabela de usuários (simplificada - sem campo grupo)
CREATE TABLE users (
  id uuid default gen_random_uuid() primary key,
  email text unique not null,
  nome text not null,
  role text default 'user' check (role in ('user', 'admin')),
  created_at timestamp default now()
);

-- 2. Criar tabela de mapeamento GSE -> equipe_id
CREATE TABLE gse_equipes (
  id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
  gse text NOT NULL UNIQUE,
  equipe_id uuid NOT NULL,
  created_at timestamp DEFAULT now()
);

-- 3. Criar tabela de tickets
  CREATE TABLE tickets (
    id uuid default gen_random_uuid() primary key,
    numero_chamado text unique not null,
    gse text not null,
    tempo_espera_origem timestamp not null,
    descricao text,
    usuario_atual uuid references users(id),
    status text default 'aguardando' check (status in ('aguardando', 'atribuido', 'em_atendimento', 'finalizado')),
    created_at timestamp default now(),
    updated_at timestamp default now(),
    version int default 1
  );

-- 4. Criar índices para performance
CREATE INDEX idx_tickets_numero_chamado ON tickets(numero_chamado);
CREATE INDEX idx_tickets_status ON tickets(status);
CREATE INDEX idx_tickets_usuario_atual ON tickets(usuario_atual);
CREATE INDEX idx_tickets_gse ON tickets(gse);
CREATE INDEX idx_gse_equipes_equipe_id ON gse_equipes(equipe_id);

-- 5. Criar função para atualizar updated_at automaticamente
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = NOW();
    RETURN NEW;
END;
$$ language 'plpgsql';

-- 6. Criar trigger para atualizar updated_at
CREATE TRIGGER update_tickets_updated_at 
BEFORE UPDATE ON tickets 
FOR EACH ROW 
EXECUTE PROCEDURE update_updated_at_column();

