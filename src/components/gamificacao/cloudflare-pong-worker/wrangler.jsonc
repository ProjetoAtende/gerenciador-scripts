{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arena-pong-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-05",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_ROOMS",
        "class_name": "MatchRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MatchRoom"
      ]
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "http://localhost:5173",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://davidpestilli.github.io"
  }
}
